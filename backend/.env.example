# Copy to .env and set a long random secret before enabling login.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-a-long-random-secret
# Optional PostgreSQL connection; if unset, a local SQLite file is used.
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/phishshield
ADMIN_TOKEN=replace-with-a-different-long-random-secret
# Optional image AI. Image analysis returns a clear 503 if not configured.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
